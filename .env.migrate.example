# Copy to .env.migrate for Phase 4 migration scripts.
# Do not commit .env.migrate — it may contain production credentials.

# ─── Postgres source (Supabase or local docker) ───────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qtodev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/qtodev"
PGSSL_REJECT_UNAUTHORIZED="false"

# ─── Garage source (legacy media — scripts/migrate-media-garage-to-r2.ts) ────
GARAGE_ENDPOINT="https://garage.example.com"
GARAGE_REGION="garage"
GARAGE_ACCESS_KEY_ID="replace_me"
GARAGE_SECRET_ACCESS_KEY="replace_me"
GARAGE_BUCKET_NAME="qtodev-media"
GARAGE_PUBLIC_URL="https://media.example.com"

# ─── R2 target ────────────────────────────────────────────────────────────────
R2_S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_REGION="auto"
R2_ACCESS_KEY_ID="replace_me"
R2_SECRET_ACCESS_KEY="replace_me"
R2_BUCKET_NAME="qtodev-media"
R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# Optional: override D1 database name for wrangler (default from wrangler.toml)
# MIGRATE_D1_DATABASE_NAME="qtodev-d1-staging"
