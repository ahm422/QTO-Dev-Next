{
  "name": "qtodev-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:webpack": "NEXT_PRIVATE_STANDALONE=true NEXT_PRIVATE_OUTPUT_TRACE_ROOT=. next build --webpack",
    "cf:build": "SKIP_BUILD_TIME_D1=1 opennextjs-cloudflare build",
    "cf:build:low-mem": "SKIP_BUILD_TIME_D1=1 npm run build:webpack && opennextjs-cloudflare build --skipNextBuild",
    "build:cloudflare": "npm run cf:build",
    "dev": "next dev",
    "postinstall": "prisma generate && node scripts/patch-opennext-wasm.mjs",
    "migrate:compare-counts": "tsx scripts/compare-migration-counts.ts",
    "migrate:media": "tsx scripts/migrate-media-garage-to-r2.ts",
    "migrate:public-images": "tsx scripts/upload-public-images-to-r2.ts",
    "migrate:cms-images": "tsx scripts/rewrite-cms-images-to-r2.ts",
    "migrate:icons": "tsx scripts/migrate-lucide-icons-to-app-icon.ts",
    "migrate:sync-staging-remote": "tsx scripts/migration/sync-staging-to-remote.ts",
    "build:analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "d1:migrate:local": "wrangler d1 migrations apply qtodev-d1 --local",
    "d1:migrate:remote": "wrangler d1 migrations apply qtodev-d1 --remote",
    "d1:migrate:staging": "wrangler d1 migrations apply qtodev-d1-staging --remote --env staging",
    "d1:migrate:staging:local": "wrangler d1 migrations apply qtodev-d1-staging --local --env staging",
    "d1:setup": "wrangler d1 migrations apply qtodev-d1 --local && npm run db:seed:local",
    "d1:setup:staging": "npm run d1:migrate:staging:local && npm run d1:migrate:staging && npm run db:seed:staging && npm run d1:sync:staging",
    "d1:sync:staging": "npm run migrate:sync-staging-remote",
    "d1:sync:production:content": "tsx scripts/migration/sync-content-to-production.ts -- --confirm-production",
    "db:seed:local": "prisma db seed",
    "db:seed:staging": "tsx prisma/seed.ts -- --d1=staging",
    "db:seed:erp-solutions:remote": "tsx scripts/seed-erp-solutions-remote.ts -- --d1=remote --confirm-production",
    "verify:seed-counts": "tsx scripts/verify-seed-counts.ts",
    "verify:seed-counts:staging": "tsx scripts/verify-seed-counts.ts -- --d1=staging",
    "admin:create-user": "tsx scripts/create-admin-user.ts",
    "preview": "opennextjs-cloudflare preview -- --ip 127.0.0.1",
    "dev:worker": "opennextjs-cloudflare preview -- --ip 127.0.0.1",
    "deploy": "npm run cf:build && wrangler deploy",
    "deploy:staging": "npm run cf:build && wrangler deploy --env staging",
    "d1:enable-replication": "bash scripts/enable-d1-read-replication.sh",
    "upload": "npm run cf:build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "secrets:verify": "bash scripts/verify-wrangler-secrets.sh",
    "secrets:verify:staging": "bash scripts/verify-wrangler-secrets.sh staging"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@icons-pack/react-simple-icons": "^13.11.1",
    "@prisma/adapter-d1": "^7.8.0",
    "@prisma/client": "7.5.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-link": "^3.30.3",
    "@tiptap/extension-placeholder": "^3.30.3",
    "@tiptap/extension-underline": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@types/ua-parser-js": "^0.7.39",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.3",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.77.0",
    "react-simple-wysiwyg": "^3.4.1",
    "recharts": "^3.7.0",
    "sanitize-html": "^2.17.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1058.0",
    "@next/bundle-analyzer": "^16.1.6",
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^30.0.1",
    "playwright": "^1.61.0",
    "prisma": "7.5.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.105.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
