    "build:cloudflare": "npm run cf:build",
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build:analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "prisma:validate": "prisma validate",
