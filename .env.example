# Prisma / PostgreSQL connection string (Supabase Transaction Pooler example)
# Important: URL-encode special characters in password and keep sslmode=require
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# For Prisma CLI (migrations/introspection), prefer a direct/session connection:
DIRECT_URL="postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
# If direct host is unreachable from your network, use Session pooler instead:
# DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Optional: if you hit TLS verification issues locally (do NOT use in production).
# When set to "true", we keep sslmode=require and do not switch to "no-verify" for pooling.
PGSSL_REJECT_UNAUTHORIZED="false"

# JWT signing secret for custom auth. Generate: openssl rand -hex 64
JWT_ACCESS_SECRET="replace-with-64-char-hex-secret"

# Optional — only for `npm run admin:create-user` (local dev superuser bootstrap)
# ADMIN_EMAIL="admin@qtodev.local"
# ADMIN_PASSWORD="choose-a-strong-password"

# Garage (S3-compatible object storage)
GARAGE_ENDPOINT="http://localhost:3900"
GARAGE_REGION="garage"
GARAGE_ACCESS_KEY_ID="replace_me"
GARAGE_SECRET_ACCESS_KEY="replace_me"
# GARAGE_BUCKET_NAME is preferred; GARAGE_BUCKET is accepted as an alias
GARAGE_BUCKET_NAME="qto-dev"
# Public read base (Garage website / s3_web port, often 3902 — not S3 API port 3900)
GARAGE_PUBLIC_URL="http://localhost:3902/qto-dev"
# Optional: production CDN hostname for next/image remotePatterns when GARAGE_PUBLIC_URL is unset at build (CI)
# GARAGE_CDN_HOSTNAME="cdn.example.com"

# Resend (transactional email)
RESEND_API_KEY="re_replace_me"
RESEND_FROM_EMAIL="hello@example.com"
RESEND_TO_EMAIL="admin@example.com"

# Public site base URL (used for SEO metadata and canonical URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret for the /api/revalidate endpoint. Send it as: Authorization: Bearer <secret>
REVALIDATE_SECRET="replace_me"

# Secret for the /api/cron/cleanup-tokens endpoint. Generate: openssl rand -hex 32
CRON_SECRET="replace-with-hex-secret"

# REQUIRED in production — in-memory fallback is dev-only and not suitable for multi-instance deployments.
# Set via: wrangler secret put UPSTASH_REDIS_REST_URL && wrangler secret put UPSTASH_REDIS_REST_TOKEN
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
