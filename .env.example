# Prisma / PostgreSQL connection string (Supabase Transaction Pooler example)
# Important: URL-encode special characters in password and keep sslmode=require
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# For Prisma CLI (migrations/introspection), prefer a direct/session connection:
DIRECT_URL="postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
# If direct host is unreachable from your network, use Session pooler instead:
# DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Optional: if you hit TLS verification issues locally (do NOT use in production).
# When set to "true", we keep sslmode=require and do not switch to "no-verify" for pooling.
PGSSL_REJECT_UNAUTHORIZED="false"

# Public site base URL (used for SEO metadata and canonical URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret for the /api/revalidate endpoint. Send it as: Authorization: Bearer <secret>
REVALIDATE_SECRET="replace_me"
