# Local Next.js (`npm run dev`). Database is Cloudflare D1 via Wrangler — not Postgres.
# Apply + seed local D1: npm run d1:setup
# Workers preview: npm run preview (uses DB binding from wrangler.toml → qtodev-d1).
# Production D1 id: YOUR_D1_DATABASE_ID
#
# Do NOT set DATABASE_URL / DIRECT_URL. Runtime Prisma uses env.DB (PrismaD1).

# JWT signing secret for custom auth. Generate: openssl rand -hex 64
JWT_ACCESS_SECRET="replace-with-64-char-hex-secret"

# Optional — only for `npm run admin:create-user` (local dev superuser bootstrap)
# ADMIN_EMAIL="admin@qtodev.local"
# ADMIN_PASSWORD="choose-a-strong-password"

# Cloudflare R2 (S3-compatible) — qtodev-media bucket
R2_S3_ENDPOINT="https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com"
R2_REGION="auto"
R2_ACCESS_KEY_ID="replace_me"
R2_SECRET_ACCESS_KEY="replace_me"
R2_BUCKET_NAME="qtodev-media"
# Enable Public Development URL in R2 bucket Settings, or use a custom domain
R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# Cloudflare Email Service (transactional) — no API key; uses EMAIL Worker binding.
# From-address must be on onboarded domain qtodev.com (not resend.dev).
EMAIL_FROM="noreply@qtodev.com"
EMAIL_ADMIN_TO="admin@example.com"

# Public site base URL (used for SEO metadata and canonical URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret for the /api/revalidate endpoint. Send it as: Authorization: Bearer <secret>
REVALIDATE_SECRET="replace_me"

# Chat widget kill switch — set to "false" to disable both the public and admin
# chat widgets without a redeploy. Defaults to enabled when unset.
NEXT_PUBLIC_CHAT_ENABLED="true"

# Public marketing-site chat bubble (bottom-right), independent of the admin
# ops widget. Defaults to enabled — set to "false" to hide the bubble.
NEXT_PUBLIC_CHAT_PUBLIC_ENABLED="true"

# Admin dashboard ops widget ("QTO Ops Assistant"), independent of the public
# widget. Defaults to enabled — set to "false" to hide it.
NEXT_PUBLIC_CHAT_ADMIN_ENABLED="true"

# ── Chatbot backend service ─────────────────────────────────────────────────
# Server-only (never exposed to the client) — base URL of the standalone `chatbot/`
# RAG service that /api/chat and /api/admin/chat proxy real messages to. Defaults to
# its local dev port; see chatbot/README.md to run it locally. Override in production
# once the service has a real deployment.
CHATBOT_SERVICE_URL="http://localhost:8787"
# Timeout (ms) for a single request to the chatbot backend service.
CHATBOT_SERVICE_TIMEOUT_MS="30000"

# Secret for the /api/cron/cleanup-tokens endpoint. Generate: openssl rand -hex 32
CRON_SECRET="replace-with-hex-secret"

# Set to 1 during production cutover to block mutating requests (forms, admin saves).
# FREEZE_WRITES="1"

# REQUIRED in production — in-memory fallback is dev-only and not suitable for multi-instance deployments.
# Set via: wrangler secret put UPSTASH_REDIS_REST_URL && wrangler secret put UPSTASH_REDIS_REST_TOKEN
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
