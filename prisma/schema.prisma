generator client {
  provider      = "prisma-client-js"
  compilerBuild = "small"
}

datasource db {
  provider = "sqlite"
}

model Contact {
  id        String   @id @default(uuid()) @map("id")
  name      String   @map("name")
  email     String   @map("email")
  subject   String   @map("subject")
  message   String   @map("message")
  source    String?  @map("source")
  referrer  String?  @map("referrer")
  userAgent String?  @map("user_agent")
  ip        String?  @map("ip")
  metadata  String?  @map("metadata")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([createdAt])
  @@map("contacts")
}

model Requirement {
  id              String   @id @default(uuid()) @map("id")
  intent          String   @map("intent")
  name            String   @map("name")
  email           String   @map("email")
  company         String?  @map("company")
  website         String?  @map("website")
  role            String?  @map("role")
  projectType     String?  @map("project_type")
  industry        String?  @map("industry")
  companySize     String?  @map("company_size")
  goals           String?  @map("goals")
  budgetRange     String?  @map("budget_range")
  startDate       String?  @map("start_date")
  launchWindow    String?  @map("launch_window")
  urgency         String?  @map("urgency")
  timeline        String?  @map("timeline")
  preferredTime   String?  @map("preferred_time")
  timezone        String?  @map("timezone")
  channel         String?  @map("channel")
  features        String?  @map("features")
  integrations    String?  @map("integrations")
  successCriteria String?  @map("success_criteria")
  message         String   @map("message")
  source          String?  @map("source")
  referrer        String?  @map("referrer")
  userAgent       String?  @map("user_agent")
  ip              String?  @map("ip")
  metadata        String?  @map("metadata")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([intent])
  @@index([email])
  @@index([createdAt])
  @@map("requirements")
}

// ─── SERVICES ───────────────────────────────────────────────────────────────
// String[] migration decisions (Phase 1):
//   features       → JSON-as-text (display-only bullet list)
//   technologyTags → join table ServiceTechnologyTag (filterable tags)
model Service {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  shortDescription String   @map("short_description")
  description      String
  icon             String
  features         String   @default("[]") // JSON string array; use parseStringArray in Phase 3
  imageUrl         String?  @map("image_url")
  imageAlt         String?  @map("image_alt")
  order            Int      @default(0)
  isPublished      Boolean  @default(true) @map("is_published")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  technologyTags ServiceTechnologyTag[]

  @@index([slug])
  @@index([order])
  @@map("services")
}

model ServiceTechnologyTag {
  id        String @id @default(uuid())
  serviceId String @map("service_id")
  value     String
  sortOrder Int    @default(0) @map("sort_order")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([value])
  @@map("service_technology_tags")
}

// ─── PRODUCTS (Products page: ERP, Construct Quest, etc.) ───────────────────
model Product {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  subtitle         String?
  shortDescription String?  @map("short_description")
  description      String
  statusLabel      String?  @map("status_label")
  titleHighlight   String?  @map("title_highlight")
  imageUrl         String?  @map("image_url")
  imageAlt         String?  @map("image_alt")
  order            Int      @default(0)
  isPublished      Boolean  @default(true) @map("is_published")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  features ProductFeature[]

  @@index([slug])
  @@index([order])
  @@map("products")
}

model ProductFeature {
  id          String  @id @default(uuid())
  productId   String  @map("product_id")
  name        String
  description String
  icon        String?
  sortOrder   Int     @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_features")
}

// ─── PROCESS STEPS (Homepage "How We Work" & Services "How We Deliver") ─────
model ProcessStep {
  id          String   @id @default(uuid())
  context     String
  stepNumber  Int      @map("step_number")
  title       String
  description String
  icon        String
  order       Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([context])
  @@index([order])
  @@map("process_steps")
}

// ─── FEATURED WORK (Homepage carousel / highlights) ─────────────────────────
// String[] migration decisions (Phase 1):
//   tags → JSON-as-text (display-only carousel pill labels)
model FeaturedWork {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?  @map("image_url")
  imageAlt    String?  @map("image_alt")
  tags        String   @default("[]") // JSON string array; use parseStringArray in Phase 3
  link        String?
  order       Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("featured_works")
}

// ─── WHY CHOOSE US ───────────────────────────────────────────────────────────
model WhyChooseUs {
  id          String   @id @default(uuid())
  context     String   @default("homepage")
  title       String
  description String
  icon        String?
  order       Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([context])
  @@map("why_choose_us")
}

// ─── STATS & NUMBERS ────────────────────────────────────────────────────────
model Stat {
  id          String   @id @default(uuid())
  label       String
  value       String
  description String?
  icon        String?
  color       String?
  order       Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("stats")
}

// ─── TESTIMONIALS ────────────────────────────────────────────────────────────
model Testimonial {
  id            String   @id @default(uuid())
  clientName    String   @map("client_name")
  clientRole    String   @map("client_role")
  clientCompany String   @map("client_company")
  quote         String
  mediaType     String   @default("none") @map("media_type")
  mediaUrl      String?  @map("media_url")
  mediaAlt      String?  @map("media_alt")
  avatarUrl     String?  @map("avatar_url")
  avatarColor   String?  @map("avatar_color")
  rating        Int?     @default(5)
  order         Int      @default(0)
  isPublished   Boolean  @default(true) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("testimonials")
}

// ─── INDUSTRIES ──────────────────────────────────────────────────────────────
// String[] migration decisions (Phase 1):
//   bulletPoints → JSON-as-text (display-only ordered prose bullets)
model Industry {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  icon         String?
  bulletPoints String   @default("[]") @map("bullet_points") // JSON string array; use parseStringArray in Phase 3
  order        Int      @default(0)
  isPublished  Boolean  @default(true) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("industries")
}

// ─── ENGAGEMENT MODELS ───────────────────────────────────────────────────────
// String[] migration decisions (Phase 1):
//   features → JSON-as-text (display-only pricing-card feature list)
model EngagementModel {
  id            String   @id @default(uuid())
  number        Int
  title         String
  description   String
  features      String   @default("[]") // JSON string array; use parseStringArray in Phase 3
  isMostPopular Boolean  @default(false) @map("is_most_popular")
  ctaLabel      String   @default("Get Started") @map("cta_label")
  ctaLink       String   @default("/contact") @map("cta_link")
  order         Int      @default(0)
  isPublished   Boolean  @default(true) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("engagement_models")
}

// ─── FAQs ─────────────────────────────────────────────────────────────────────
model Faq {
  id          String   @id @default(uuid())
  question    String
  answer      String
  context     String   @default("homepage")
  order       Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([context])
  @@index([order])
  @@map("faqs")
}

// ─── BLOG POSTS ───────────────────────────────────────────────────────────────
// String[] migration decisions (Phase 1):
//   tags → join table BlogPostTag (tag pages / filtering likely)
model BlogPost {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  category    String
  author      String    @default("QTO DEV Team")
  imageUrl    String?   @map("image_url")
  imageAlt    String?   @map("image_alt")
  readTime    Int?      @map("read_time")
  isFeatured  Boolean   @default(false) @map("is_featured")
  isHeadline  Boolean   @default(false) @map("is_headline")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tags BlogPostTag[]

  @@index([slug])
  @@index([category])
  @@index([isPublished, publishedAt])
  @@map("blog_posts")
}

model BlogPostTag {
  id         String @id @default(uuid())
  blogPostId String @map("blog_post_id")
  value      String
  sortOrder  Int    @default(0) @map("sort_order")

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([blogPostId])
  @@index([value])
  @@map("blog_post_tags")
}

// ─── TECHNOLOGIES (Tech Stack) ───────────────────────────────────────────────
model Technology {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  iconKey     String   @map("icon_key")
  order       Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("technologies")
}

// ─── PROJECTS / PORTFOLIO ────────────────────────────────────────────────────
// String[] migration decisions (Phase 1):
//   tags      → join table ProjectTag (portfolio tag filtering likely)
//   results   → JSON-as-text (display-only outcome bullets)
//   images    → JSON-as-text (display-only ordered URL list)
//   techStack → join table ProjectTechStackItem (filterable stack labels)
model Project {
  id            String    @id @default(uuid())
  slug          String    @unique
  title         String
  client        String?
  category      String
  excerpt       String
  description   String
  challenge     String?
  solution      String?
  results       String    @default("[]") // JSON string array; use parseStringArray in Phase 3
  coverImageUrl String?   @map("cover_image_url")
  images        String    @default("[]") // JSON string array; use parseStringArray in Phase 3
  liveUrl       String?   @map("live_url")
  serviceSlug   String?   @map("service_slug")
  isFeatured    Boolean   @default(false) @map("is_featured")
  order         Int       @default(0)
  isPublished   Boolean   @default(true) @map("is_published")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tags      ProjectTag[]
  techStack ProjectTechStackItem[]

  @@index([slug])
  @@index([category])
  @@index([order])
  @@index([serviceSlug])
  @@map("projects")
}

model ProjectTag {
  id        String @id @default(uuid())
  projectId String @map("project_id")
  value     String
  sortOrder Int    @default(0) @map("sort_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([value])
  @@map("project_tags")
}

model ProjectTechStackItem {
  id        String @id @default(uuid())
  projectId String @map("project_id")
  value     String
  sortOrder Int    @default(0) @map("sort_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([value])
  @@map("project_tech_stack_items")
}

// ─── WORK VALUES ("Why Our Work Matters") ───────────────────────────────────
model WorkValue {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String?
  order       Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("work_values")
}

// ─── ABOUT PAGE CONTENT ──────────────────────────────────────────────────────
model AboutContent {
  id          String   @id @default(uuid())
  section     String   @unique
  title       String?
  subtitle    String?
  body        String?
  metadata    String?
  imageUrl    String?  @map("image_url")
  order       Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("about_content")
}

// ─── TEAM / LEADERSHIP ───────────────────────────────────────────────────────
model TeamMember {
  id          String   @id @default(uuid())
  name        String
  role        String
  bio         String?
  avatarUrl   String?  @map("avatar_url")
  linkedIn    String?  @map("linked_in")
  order       Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  isFounder   Boolean  @default(false) @map("is_founder")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("team_members")
}

// ─── JOBS / CAREERS ──────────────────────────────────────────────────────────
// String[] migration decisions (Phase 1):
//   requirements → JSON-as-text (display-only job detail bullet list)
//   niceToHave   → JSON-as-text (display-only optional list)
model Job {
  id           String    @id @default(uuid())
  title        String
  department   String
  location     String
  type         String
  description  String
  requirements String    @default("[]") // JSON string array; use parseStringArray in Phase 3
  niceToHave   String    @default("[]") @map("nice_to_have") // JSON string array; use parseStringArray in Phase 3
  salaryRange  String?   @map("salary_range")
  applyUrl     String?   @map("apply_url")
  order        Int       @default(0)
  isPublished  Boolean   @default(true) @map("is_published")
  postedAt     DateTime  @default(now()) @map("posted_at")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  applications JobApplication[]

  @@index([department])
  @@index([isPublished])
  @@map("jobs")
}

model JobApplication {
  id          String   @id @default(uuid())
  jobId       String   @map("job_id")
  jobTitle    String   @map("job_title")
  name        String
  email       String
  phone       String?
  coverLetter String?  @map("cover_letter")
  resumeUrl   String?  @map("resume_url")
  linkedinUrl String?  @map("linkedin_url")
  source      String?
  referrer    String?
  userAgent   String?  @map("user_agent")
  ip          String?
  metadata    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([email])
  @@map("job_applications")
}

// ─── CONTACT INFO (Other ways to reach us) ──────────────────────────────────
model ContactInfo {
  id          String   @id @default(uuid())
  type        String
  label       String
  value       String
  subLabel    String?  @map("sub_label")
  icon        String?
  order       Int      @default(0)
  isPublished Boolean  @default(true) @map("is_published")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("contact_info")
}

// ─── PAGE SECTIONS (per-page chrome: heroes, headings, CTAs) ────────────────
model PageSection {
  slug        String   @id // e.g. "homepage.hero", "services.page"
  label       String? // human-readable name shown in admin
  data        String   @default("{}") // section content JSON; use parseMetadata in Phase 3
  isPublished Boolean  @default(true) @map("is_published")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("page_sections")
}

// ─── SITE CONFIG (global key-value settings) ─────────────────────────────────
model SiteConfig {
  key       String   @id
  value     String
  label     String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_config")
}

// ─── ADMIN USERS ─────────────────────────────────────────────────────────────
model AdminUser {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String    @map("password_hash")
  role              String    @default("admin")
  displayName       String?   @map("display_name")
  isActive          Boolean   @default(true) @map("is_active")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")
  lastLoginAt       DateTime? @map("last_login_at")
  lastLoginIp       String?   @map("last_login_ip")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("admin_users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id")
  userAgent  String?   @map("user_agent")
  ip         String?
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  email     String?
  action    String
  ip        String?
  userAgent String?  @map("user_agent")
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")

  user AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
