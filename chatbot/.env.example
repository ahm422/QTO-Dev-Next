# ─────────────────────────────────────────────────────────────────────────
# QTO Dev Chatbot — standalone service configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────

# ── D1 access (READ-ONLY) ───────────────────────────────────────────────────
# D1_MODE=local (default): reads the main app's local D1 sqlite file directly
# via better-sqlite3, opened read-only. No Cloudflare account/token needed.
# Requires the main app's local D1 to exist first — in the repo root run:
#   npm run d1:setup
# The file is auto-discovered under ../.wrangler/state/v3/d1/miniflare-D1DatabaseObject/.
# Only set LOCAL_D1_SQLITE_PATH if you need to point at a different file.
D1_MODE=local
LOCAL_D1_SQLITE_PATH=

# D1_MODE=remote: reads the real Cloudflare D1 database over its HTTP API instead
# (production/staging). Only needed if you switch D1_MODE to "remote".
# Create a token at https://dash.cloudflare.com/profile/api-tokens with
# ONLY the "D1: Read" permission scoped to this account.
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=
# From wrangler.toml in the main app:
#   production database_id = YOUR_D1_DATABASE_ID  (qtodev-d1)
#   staging database_id    = YOUR_STAGING_D1_DATABASE_ID  (qtodev-d1-staging)
CLOUDFLARE_D1_DATABASE_ID=

# ── Qdrant (vector store) ──────────────────────────────────────────────────
# Local dev: run `docker run -p 6333:6333 qdrant/qdrant` and use the default below.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=qtodev_knowledge_base

# ── Embedding model (runs locally via @xenova/transformers, no API key) ────
# Default is a small, well-established 384-dim sentence embedding model.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# ── LLM provider (configurable — any OpenAI-compatible chat completions API) ─
# Default is DeepSeek. Swap base URL/model to point at another OpenAI-compatible
# provider (OpenAI, Groq, a local Ollama+OpenAI-compat proxy, etc.) without code changes.
LLM_PROVIDER_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=1000

# ── Chat API server ─────────────────────────────────────────────────────────
CHAT_PORT=8787
# Comma-separated list of allowed origins for the chat widget, or "*" for local dev.
CHAT_CORS_ORIGIN=*
CHAT_MAX_MESSAGE_LENGTH=2000
# Primary input guardrail — rejects messages over this many words.
CHAT_MAX_MESSAGE_WORDS=100
CHAT_MAX_HISTORY_MESSAGES=40
CHAT_SESSION_TTL_MINUTES=60
# Include `sources`/`timing` in the /chat response. Keep false for the real customer
# widget — these are retrieval/latency internals, not something a visitor should see.
# Set true only for local debugging.
CHAT_EXPOSE_DEBUG_INFO=false

# Rate limiting (in-memory, per IP — see README for multi-instance caveats)
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# ── Retrieval ────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.3

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP_CHARS=150

# ── Sync ────────────────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=15
SYNC_ON_STARTUP=true
# Shared secret required in the `x-sync-token` header to call POST /sync/run.
# Generate with: openssl rand -hex 32
SYNC_TRIGGER_TOKEN=

# ── Misc ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
